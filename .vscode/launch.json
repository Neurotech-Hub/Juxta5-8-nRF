{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch nRF Connect application",
            "config": "juxta5-8-blink",
            "flash": true,
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch the active build configuration",
            "config": "${activeConfig}",
            "flash": true,
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch active config (RTT logs)",
            "config": "${activeConfig}",
            "snr": "802004887",
            "gdbServer": {
                "args": {
                    "if": "SWD",
                    "speed": 4000,
                    "device": "NRF52840_XXAA",
                    "select": "usb=${snr}",
                    "port": "${port}",
                    "rtos": "${rtosPlugin}",
                    "jlinkscriptfile": "${jlinkScript}",
                    "additionalArgs": [
                        "singlerun",
                        "nogui",
                        "halt",
                        "noir",
                        "silent"
                    ]
                }
            },
            "flash": true,
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-blink",
            "config": "${workspaceFolder}/applications/juxta5-8-blink/build/juxta5-8-blink",
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-axy",
            "config": "${workspaceFolder}/applications/juxta5-8-axy/build/juxta5-8-axy",
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-mem",
            "config": "${workspaceFolder}/applications/juxta5-8-mem/build/juxta5-8-mem",
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-ble-test",
            "config": "${workspaceFolder}/applications/juxta5-8-ble-test/build/juxta5-8-ble-test",
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-prod",
            "config": "${workspaceFolder}/applications/juxta5-8-prod/build/juxta5-8-prod",
            "runToEntryPoint": "main"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch juxta5-8-ble-range",
            "config": "${workspaceFolder}/applications/juxta5-8-ble-range/build/juxta5-8-ble-range",
            "runToEntryPoint": "main"
        }
    ]
}