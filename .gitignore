# --- Zephyr / nRF Connect SDK -------------------------------------------------
# Standard `build/` plus common multi-configuration names (e.g. build-adv, build-scan).
applications/**/build/
applications/**/build-*/

# Exception: keep the signed DFU package for juxta5-8-prod in the repo so the
# latest MCUboot SMP BLE image is always available alongside the source (no
# rebuild required to flash via nRF Device Manager).  Git cannot re-include a
# file inside an excluded directory, so we (1) un-ignore the build dir, (2)
# re-ignore everything in it, then (3) un-ignore the one file we want.
!applications/juxta5-8-prod/build/
applications/juxta5-8-prod/build/*
!applications/juxta5-8-prod/build/dfu_application.zip

# Top-level west/sysbuild output if you build from the repo root.
/build/

# Twister / CI output (if used later).
twister-out/
sanity-out/

# Firmware images (normally only under build/; ignore anywhere under applications).
applications/**/*.hex
applications/**/*.bin
applications/**/*.elf
applications/**/*.uf2
applications/**/*.map

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Python (scripts or tooling in-repo).
__pycache__/
*.py[cod]
.venv/
venv/
/applications/juxta5-8-prod/debug
/Reference/nRF/samples
Reference/nRF/Juxta5.code-workspace
Reference/C2939873.pdf
